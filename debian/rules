#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	$(MAKE)

# dh_installsystemd installs debian/neighbot.service where the release
# keeps units: /lib/systemd/system up to bookworm, /usr/lib since trixie
override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/neighbot
	sed 's|/usr/local/sbin|/usr/sbin|' neighbot.service \
		> debian/neighbot.service

# dh_fixperms opens every directory to 0755; keep the database directory
# 0750, as make install and the daemon make it
override_dh_fixperms:
	dh_fixperms
	chmod 0750 debian/neighbot/var/neighbot

override_dh_auto_test:

override_dh_auto_clean:
	$(MAKE) clean || true
	rm -f debian/neighbot.service
