# Maintainer: Renaud Allard <renaud@allard.it>
pkgname=neighbot
pkgver=0.5.18
pkgrel=0
pkgdesc="Network neighbor monitoring daemon"
url="https://github.com/renaudallard/neighbot"
arch="all"
license="BSD-2-Clause"
depends=""
makedepends="libpcap-dev linux-headers"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
	make
}

check() {
	make test
	for t in test_parse test_dbload test_dbexpire test_ouiload \
	    test_probe test_capture test_notify; do
		./tests/$t || return 1
	done
}

package() {
	make install PREFIX=/usr DESTDIR="$pkgdir"
}
