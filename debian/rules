#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	$(MAKE)

# dh_installsystemd installs debian/neighbot.service where the release
# keeps units: /lib/systemd/system up to bookworm, /usr/lib since trixie
override_dh_auto_install:
	$(MAKE) install PREFIX=/usr DESTDIR=$(CURDIR)/debian/neighbot
	sed 's|/usr/local/sbin|/usr/sbin|' neighbot.service \
		> debian/neighbot.service
	install -d -m 755 $(CURDIR)/debian/neighbot/var/neighbot

override_dh_auto_test:

override_dh_auto_clean:
	$(MAKE) clean || true
	rm -f debian/neighbot.service
