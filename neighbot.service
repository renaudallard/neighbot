[Unit]
Description=Network neighbor monitoring daemon
Wants=network-online.target
After=network-online.target
# give up after repeated failures (an interface named with -i that is
# gone for good, an unreadable database) instead of restarting forever
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/sbin/neighbot -q
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
